# Copy to .env and adjust as needed. All values have sensible defaults.

# Local default is a SQLite file. For the cloud, use an async Postgres URL:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./transactions.db

# Spec requires 30. Lower it (e.g. 2) for fast local testing.
PROCESSING_DELAY_SECONDS=30

# How often the background worker scans for due work.
WORKER_POLL_INTERVAL_SECONDS=2
